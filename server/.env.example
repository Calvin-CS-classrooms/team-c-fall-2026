# Copy this file to .env and fill in your real values.
# The .env file is git-ignored and must never be committed.

# Supabase project URL, e.g. https://your-project.supabase.co
# Found in Supabase Dashboard -> Project Overview (under the databse title)
SUPABASE_URL=

# Supabase service role key (server-side only — never expose to the client).
# Found in Supabase Dashboard -> Project Settings -> API Keys -> Secret Keys
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to serve the bundled mock data instead of querying Supabase.
# Useful for development without a database. Unset or "false" uses Supabase.
USE_MOCK_DATA=false
